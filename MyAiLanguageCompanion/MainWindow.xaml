<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyAiLanguageCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Language Companion"
        Width="1200" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        Background="#0B1020" Foreground="#ECF3FF">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#121B2D" CornerRadius="22" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="AI Language Companion" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Talk with anyone. Understand instantly. Practice naturally." Foreground="#A5B4CE" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Supported languages: " Foreground="#A5B4CE" VerticalAlignment="Center"/>
                    <TextBlock Text="🇬🇧 🇪🇸 🇳🇱 🇷🇺" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="LIVE SHARE">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="LIVE SHARE" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio source" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="12,0,0,0" SelectedItem="{Binding SelectedLiveSource}" ItemsSource="{Binding LiveSources}" Height="34"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Ellipse Width="12" Height="12" Fill="{Binding LiveIndicatorBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding LiveStatusText}" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="Start" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartLiveShare_Click"/>
                                <Button Content="Pause" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Stop" Style="{StaticResource SecondaryButton}" Click="StopLiveShare_Click"/>
                            </StackPanel>

                            <TextBlock Text="Detected language" Foreground="#A5B4CE" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentDetectedLanguageDisplay}" FontSize="24" FontWeight="Bold" Margin="0,8,0,12"/>

                            <TextBlock Text="Transcript" Foreground="#A5B4CE" FontWeight="SemiBold"/>
                            <Border Background="#0F172A" BorderBrush="#2E3C59" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,8,0,12">
                                <TextBox Text="{Binding LiveTranscript}" Background="Transparent" BorderThickness="0" Foreground="#ECF3FF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="130"/>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Translate" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="🔊 Word" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SpeakWord_Click"/>
                                <Button Content="🔊 Sentence" Style="{StaticResource SecondaryButton}" Click="SpeakSentence_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Session details" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="Source" Foreground="#A5B4CE"/>
                            <TextBlock Text="{Binding SelectedLiveSource}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,16"/>
                            <TextBlock Text="Status" Foreground="#A5B4CE"/>
                            <TextBlock Text="{Binding LiveStatusText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"/>
                            <TextBlock Text="Model status" Foreground="#A5B4CE"/>
                            <TextBlock Text="Local dictionary + Windows TTS" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="Language uncertain" Foreground="#FFB84D" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="TRANSLATE">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SOURCE" Foreground="#A5B4CE" FontWeight="SemiBold"/>
                                <ComboBox Margin="0,8,0,0" SelectedItem="{Binding SourceLanguage}" ItemsSource="{Binding Languages}" Height="34"/>
                                <TextBox Margin="0,12,0,0" Text="{Binding TranslationInput}" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <Button Content="Translate" Style="{StaticResource PrimaryButton}" Click="Translate_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TARGET" Foreground="#A5B4CE" FontWeight="SemiBold"/>
                                <ComboBox Margin="0,8,0,0" SelectedItem="{Binding TargetLanguage}" ItemsSource="{Binding Languages}" Height="34"/>
                                <Border Background="#0F172A" BorderBrush="#2E3C59" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0" MinHeight="140">
                                    <TextBox Text="{Binding TranslationResultText}" Background="Transparent" BorderThickness="0" Foreground="#ECF3FF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Copy" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="🔊 Word" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SpeakWord_Click"/>
                        <Button Content="🔊 Sentence" Style="{StaticResource SecondaryButton}" Click="SpeakSentence_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Detected: {Binding DetectedLanguageDisplay}" Foreground="#A5B4CE" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Text="{Binding TranslationNote}" Foreground="#FFB84D" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="PRACTICE">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Practice Dutch" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="Target phrase" Foreground="#A5B4CE" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding PracticePhrase}" Height="60" FontSize="18"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="🔊 Hear" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="🎙 Record" Style="{StaticResource PrimaryButton}" Click="Practice_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Your attempt" Foreground="#A5B4CE"/>
                            <TextBox Text="{Binding PracticeAttempt}" Height="80" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Analysis" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding PracticeResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Word}" FontSize="16" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Potential issue" Foreground="#FFB84D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PracticeIssue}" FontSize="18" Margin="0,8,0,0"/>
                            <Button Content="🔊 Hear correct pronunciation" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Default source language" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding SourceLanguage}" ItemsSource="{Binding Languages}" Height="34"/>
                                <TextBlock Text="Default target language" Margin="0,10,0,4"/>
                                <ComboBox SelectedItem="{Binding TargetLanguage}" ItemsSource="{Binding Languages}" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="TTS voice" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding TtsVoices}" SelectedItem="{Binding SelectedVoice}" Height="34"/>
                                <TextBlock Text="Playback speed" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding SelectedPlaybackSpeed}" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
